    },
    {
      "id": "b388f11b-e9bd-5f8e-aa06-dcd833f147ce",
      "name": "Validate scan scope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const x=$input.first().json;if(!['facebook','instagram','tumblr'].includes(x.platform)||!String(x.account_id||'').match(/^[A-Za-z0-9_.:@-]{1,160}$/))throw Error('Explicit configured account required');return [{json:{platform:x.platform,account_id:String(x.account_id),max_posts:Math.max(1,Math.min(20,Number(x.max_posts)||20)),cursor:typeof x.cursor==='string'?x.cursor:null}}];"
      },
      "position": [
        300,
        0
      ],
      "notes": "",
      "notesInFlow": false
    },
    {
      "id": "ce274346-5348-58bd-82a3-661e00338e7f",
      "name": "Scan bounded batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://sh01.vivojaymail.workers.dev/social/inventory/scan",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 360000
        }
      },
      "position": [
        600,
        0
      ],
      "notes": "Bind social X-API-KEY. Persist resume_cursor privately; pass it on the next batch. No automatic retry or loop. Use run_social_scan.py for atomic checkpoint persistence.",
      "notesInFlow": true,
      "retryOnFail": false
    }
  ],
  "connections": {
    "Scan input": {
      "main": [
