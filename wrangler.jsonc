{
  "name": "sh01-operations-dashboard-cloudflare",
  "main": "worker.js",
  "compatibility_date": "2026-11-03",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sh01-operations-dashboard-cloudflare",
      "database_id": "fa0eeb6b-20ab-439f-a822-917022229230"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
